# Copy to .env.local and fill in real values. Never commit .env.local.

# REQUIRED — Clerk publishable key (starts with pk_test_ or pk_live_).
# Get it from Clerk Dashboard → your app → API Keys → Publishable key.
# The key embeds your Clerk Frontend API host; the browser downloads
# clerk.browser.js from that host, so a wrong host makes sign-in hang.
# This is PUBLIC and safe to ship to the browser. Never put the Clerk
# SECRET key (sk_...) in this file or anywhere in frontend code.
VITE_CLERK_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# optional legacy alias; VITE_SUPABASE_PUBLISHABLE_KEY wins if both are set
VITE_SUPABASE_ANON_KEY=
